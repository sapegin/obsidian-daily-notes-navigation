{
  "name": "obsidian-daily-notes-navigation",
  "version": "1.0.0",
  "private": true,
  "description": "Obsidian plugin that provides commands to navigate to previous and next daily notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "pretest": "npm run lint",
    "test": "true",
    "posttest": "npm run format",
    "lint": "eslint . --cache --fix",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "format": "prettier --write \"**/*.{js,mjc,cjs,ts,tsx,json,jsonc,md}\"",
    "version": "node version-bump.mjs",
    "prepare": "husky"
  },
  "keywords": [],
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapegin/obsidian-daily-notes-navigation.git"
  },
  "bugs": {
    "url": "https://github.com/sapegin/obsidian-daily-notes-navigation/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.10.1",
    "builtin-modules": "5.0.0",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-config-tamia": "9.9.1",
    "husky": "9.1.7",
    "nano-staged": "0.9.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "obsidian": "^1"
  },
  "nano-staged": {
    "*.{js,mjc,cjs,ts,tsx}": "eslint --cache --fix",
    "*.{js,mjc,cjs,ts,tsx,json,jsonc,md}": "prettier --write"
  }
}
